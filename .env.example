ENV=dev
AUTH_MODE=oidc
DATABASE_URL=postgresql+psycopg://carepilot:carepilot@postgres:5432/carepilot
OIDC_ISSUER=http://localhost:8080/realms/carepilot
OIDC_AUDIENCE=carepilot-api
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
# Tarifs en EUR / 1M tokens, à renseigner d'après la grille OpenAI en vigueur (non codés en dur)
OPENAI_PRICE_IN_PER_1M_EUR=0
OPENAI_PRICE_OUT_PER_1M_EUR=0
EMBEDDING_DIM=1536
POSTGRES_PASSWORD=carepilot
# Frontend (Vite) — publics, ne jamais y mettre de secret
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=carepilot
VITE_KEYCLOAK_CLIENT=carepilot-web
# Morocco / patient portal
TIMEZONE=Africa/Casablanca
PUBLIC_WEB_URL=http://localhost:5173
DEMO_MODE=false
PATIENT_SESSION_SECRET=
FILE_ENCRYPTION_KEY=
STORAGE_BACKEND=db
MAX_UPLOAD_MB=10
MESSAGING_PROVIDER=console
# Set SMTP_* and TWILIO_* only on the backend to enable actual delivery.
