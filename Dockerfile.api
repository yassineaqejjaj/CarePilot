FROM docker.io/library/python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara poppler-utils ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('Systran/faster-whisper-tiny', local_dir='/opt/voice/tiny', allow_patterns=['model.bin','config.json','tokenizer.json','vocabulary.*','preprocessor_config.json'])"
COPY ai ./ai
COPY apps ./apps
COPY scripts/start-api.sh ./scripts/start-api.sh
ENV PYTHONPATH=/srv:/srv/apps/api:/srv/apps/worker
CMD ["/srv/scripts/start-api.sh"]
