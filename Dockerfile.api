FROM docker.io/library/python:3.12-slim
WORKDIR /srv
COPY pyproject.toml .
RUN pip install --no-cache-dir . 2>/dev/null || pip install --no-cache-dir fastapi "uvicorn[standard]" pydantic pydantic-settings sqlalchemy alembic "psycopg[binary]" pgvector "pyjwt[crypto]" httpx openai celery prometheus-client
COPY ai ./ai
COPY apps ./apps
ENV PYTHONPATH=/srv:/srv/apps/api:/srv/apps/worker
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
